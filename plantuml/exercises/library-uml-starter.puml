@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

' Only some items can be borrowed, so borrowing is a capability (interface)
' rather than something every Item has.
interface Borrowable {
  + borrow(member : Member) : Loan
  + returnItem() : void
  + isOnLoan() : boolean
  + placeHold(member : Member) : Hold
}

' Books and DVDs differ only in how long they can be borrowed for, so the loan
' period is a field here; Book and DVD just supply its value (21 vs 7 days).
abstract class BorrowableItem {
  - loanPeriodDays : int
  - currentLoan : Loan
  - holds : List<Hold>
  + borrow(member : Member) : Loan
  + returnItem() : void
  + isOnLoan() : boolean
  + placeHold(member : Member) : Hold
}

class Book {
  + Book(title : String, catalogueNumber : String)
}

class DVD {
  + DVD(title : String, catalogueNumber : String)
}

' Reference-only items do not realize Borrowable, so they cannot be borrowed.
class ReferenceItem {
  + ReferenceItem(title : String, catalogueNumber : String)
}

class Loan {
  - dueDate : LocalDate
  + getBorrower() : Member
  + isOverdue() : boolean
}

' The item remembers its holds: it still exists, and is easy to find, at the
' moment it is returned and someone needs to know who is waiting.
class Hold {
  - datePlaced : LocalDate
  + getMember() : Member
}

class Catalogue {
  + addItem(item : Item) : void
  + findByCatalogueNumber(number : String) : Item
}

abstract class Person {
  - name : String
  + getName() : String
}

class Member {
  - memberNumber : String
  - lateFee : double
  + logIn(memberNumber : String) : boolean
  + getLateFee() : double
  + setLateFee(amount : double) : void
}

class Librarian {
  + addItem(catalogue : Catalogue, item : Item) : void
  + waiveLateFee(member : Member) : void
}

' generalization
Item <|-- BorrowableItem
Item <|-- ReferenceItem
BorrowableItem <|-- Book
BorrowableItem <|-- DVD
Person <|-- Member
Person <|-- Librarian

' realization
Borrowable <|.. BorrowableItem

' associations
Catalogue o-- Item : contains
BorrowableItem --> Loan : currentLoan
BorrowableItem --> Hold : holds
Loan --> Member : borrower
Hold --> Member : placedBy

' dependencies (uses, without storing a reference)
Member ..> Borrowable : borrows / places hold on
Librarian ..> Catalogue : adds items to
Librarian ..> Member : waives late fee of

@enduml
